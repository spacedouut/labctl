#!/usr/bin/env python3
"""Fake pvesh — structured host status."""
import json
import sys

args = sys.argv[1:]
if args and args[0] == "get" and "/status" in args[1]:
    print(json.dumps({
        "node": "pvetest",
        "pveversion": "pve-manager/8.4.1/fake",
        "kversion": "6.8.12-4-pve",
        "uptime": 1234567,
        "cpu": 0.12,
        "loadavg": [0.4, 0.3, 0.2],
        "memory": {"total": 64000000000, "used": 20000000000, "free": 44000000000},
    }))
else:
    print(json.dumps({}), file=sys.stderr)
    sys.exit(1)
