{
  "naming": {
    "pattern": "^[a-z][a-z0-9-]*$",
    "max_length": 63,
    "env_separator": "-"
  },

  "default_user": "ubuntu",

  "networks": {
    "lan":  ["192.168.0.0/16"],
    "mgmt": ["10.0.0.0/8"]
  },

  "templates": {
    "prefix": "tpl",
    "separator": "-",
    "sizes": {
      "micro":  { "cores": 1, "memory": 1024 },
      "small":  { "cores": 2, "memory": 2048 },
      "medium": { "cores": 4, "memory": 4096 },
      "large":  { "cores": 8, "memory": 8192 }
    }
  },

  "bootstrap": {
    "directory": "/opt/phase/bootstrap",
    "os_overrides": {
      "ubuntu-26": { "system": "ubuntu/initialize_system.sh" },
      "debian-12": { "system": "debian/initialize_system.sh" },
      "arch": { "system": "arch/initialize_system.sh" },
      "alpine-3-21": { "system": "alpine/initialize_system.sh" }
    }
  },

  "vm": {
    "agent": true,
    "ssh_keys": ["/root/.ssh/id_ed25519.pub"]
  },

  "ui": {
    "confirm_destructive": true
  }
}
