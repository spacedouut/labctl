{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/spacedouut/phase/config.schema.json",
  "title": "phase configuration (v4)",
  "description": "Configuration schema for phase — a CLI for managing Proxmox VE virtual machines",

  "type": "object",
  "additionalProperties": false,
  "required": [],

  "properties": {
    "default_user": {
      "description": "SSH user used when a VM's cloud-init ciuser is not set",
      "type": "string",
      "default": "root"
    },

    "default_storage": {
      "description": "Storage used for data disks when --storage is omitted",
      "type": "string"
    },

    "naming": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pattern": { "type": "string", "default": "^[a-z][a-z0-9-]*$" },
        "max_length": { "type": "integer", "minimum": 1, "maximum": 255, "default": 63 },
        "env_separator": { "type": "string", "default": "-" }
      }
    },

    "networks": {
      "description": "Network aliases: name → CIDR list. Used by firewall rules (--from <alias>) and best-IP selection",
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": { "type": "string", "pattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}/([0-9]|[12][0-9]|3[0-2])$" }
      }
    },

    "templates": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "prefix": { "type": "string", "default": "tpl" },
        "separator": { "type": "string", "default": "-" },
        "sizes": {
          "description": "Machine-type presets (cores/memory MB). `--size auto` derives from the template instead",
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["cores", "memory"],
            "properties": {
              "cores": { "type": "integer", "minimum": 1 },
              "memory": { "type": "integer", "minimum": 128 }
            }
          }
        }
      }
    },

    "bootstrap": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "directory": { "type": "string", "default": "/opt/phase/bootstrap" },
        "os_overrides": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": { "type": "string" }
          }
        }
      }
    },

    "vm": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "agent": { "type": "boolean", "default": true },
        "ssh_keys": {
          "description": "SSH public keys injected into every new VM (path to .pub or literal key). Managed via `phase ssh-key`",
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },

    "web": {
      "description": "Phase web-console authentication and session settings",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "token": { "description": "Legacy shared access token; use PAM mode for named users", "type": "string" },
        "auth": { "description": "Authentication mode", "enum": ["none", "token", "pam"] },
        "pam_users": { "description": "Explicit allowlist of Proxmox PAM users permitted to administer Phase", "type": "array", "items": { "type": "string", "pattern": ".+@pam$" }, "uniqueItems": true },
        "session_ttl_hours": { "description": "PAM web-session lifetime (1-168 hours)", "type": "integer", "minimum": 1, "maximum": 168, "default": 12 }
      }
    },

    "gpus": {
      "description": "Optional static GPU/mdev overrides: gpus.<mdev-type>.pci pins a PCI address. Auto-discovered by `phase engine scan` otherwise",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": { "pci": { "type": "string", "pattern": "^[0-9a-fA-F]{4}:[0-9a-fA-F]{2}:[0-9a-fA-F]{2}\\.[0-9a-fA-F]$" } }
      }
    },

    "remote": {
      "description": "Run phase from a different machine: tunnel qm/pvesh over SSH. Also settable via --host / PHASE_HOST",
      "type": "object",
      "additionalProperties": false,
      "properties": { "host": { "type": "string" } }
    },

    "notify": {
      "description": "Push notifications for long operations. Requires the [notify] extra (apprise)",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "default": false },
        "urls": {
          "description": "Apprise URLs (e.g. discord://..., telegram://..., ntfy://...)",
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },

    "api": {
      "description": "Proxmox REST API credentials for the [api] extra transport (falls back to qm CLI when absent)",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "host": { "type": "string" },
        "node": { "type": "string" },
        "token_id": { "type": "string" },
        "token_secret": { "type": "string" },
        "verify_ssl": { "type": "boolean", "default": true }
      }
    },

    "backup": {
      "description": "vzdump defaults for `phase vm <name> backup`",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "storage": { "type": "string", "default": "local" },
        "mode": { "enum": ["snapshot", "suspend", "stop"], "default": "snapshot" },
        "compress": { "enum": ["zstd", "gzip", "lzo", "none"], "default": "zstd" }
      }
    },

    "engine": {
      "description": "The engine daemon (phase engine daemon / systemd service)",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "jobs": {
          "description": "Scheduled jobs run by the daemon",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "interval_seconds", "command"],
            "properties": {
              "name": { "type": "string" },
              "interval_seconds": { "type": "number", "minimum": 1 },
              "command": { "type": "array", "items": { "type": "string" } },
              "enabled": { "type": "boolean", "default": true }
            }
          }
        },
        "systemd": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "unit": { "type": "string", "default": "/etc/systemd/system/phase-engine.service" }
          }
        }
      }
    },

    "ui": {
      "description": "UI preferences",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "confirm_destructive": { "type": "boolean", "default": true }
      }
    }
  }
}
